# Скопируйте этот файл в .env и подставьте свои значения:
#     cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# Файл .env НЕ коммитим в git (он в .gitignore), а .env.example коммитим: это шаблон без секретов.

# SQLite: ничего устанавливать не нужно, база лежит в файле рядом с проектом
DATABASE_URL=sqlite:///./shop.db

# PostgreSQL: нужен драйвер (pip install "psycopg[binary]"), раскомментируйте и поменяйте значения
# DATABASE_URL=postgresql+psycopg://shop_user:CHANGE_ME@localhost:5432/shop
